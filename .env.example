# Copy to .env. This file is the sample; .env stays on your computer and is not uploaded.

# ── Core ─────────────────────────────────────────────────────────────────────
DATABASE_URL="postgresql://YOUR_POSTGRES_USER@localhost:5432/adrya_crm"
SESSION_SECRET="replace-with-a-long-random-string"
DEBUG="1"
ALLOWED_HOSTS="localhost,127.0.0.1"

# ── API / Intake ─────────────────────────────────────────────────────────────
INTAKE_API_KEY="replace-with-a-private-api-key"
# Email of the user that owns leads created via the intake API.
# Falls back to the first ADMIN if left blank.
INTAKE_USER_EMAIL=""

# ── Cloudflare R2 (free 10 GB — leave blank to use local filesystem) ─────────
# 1. Create a free Cloudflare account → R2 → Create bucket
# 2. R2 → Manage API tokens → Create token (Object Read & Write)
# 3. Copy Account ID from R2 overview page
CLOUDFLARE_ACCOUNT_ID=""
CLOUDFLARE_R2_BUCKET_NAME=""
CLOUDFLARE_R2_ACCESS_KEY_ID=""
CLOUDFLARE_R2_SECRET_ACCESS_KEY=""

# ── Production (set DEBUG=0 to activate HTTPS + security headers) ─────────────
# DB_CONN_MAX_AGE=60
